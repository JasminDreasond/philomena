= form_for @changeset, @action, fn f ->
  = if @changeset.action do
    .alert.alert-danger
      p Oops, something went wrong! Please check the errors below.

  = hidden_input f, :user_id

  .field
    => label f, :reason, "Reason (shown to the banned user, and to staff on the user's profile page):"
    = text_input f, :reason, class: "input input--wide", placeholder: "Reason", required: true
    = error_tag f, :reason

  .field
    => label f, :note, "Admin-only note:"
    = text_input f, :note, class: "input input--wide", placeholder: "Note"

  .field
    => label f, :valid_until, "End time relative to now, in simple English (e.g. \"1 week from now\"):"
    = text_input f, :valid_until, class: "input input--wide", placeholder: "Until", required: true
    = error_tag f, :valid_until

  br
  .field
    => checkbox f, :enabled
    = label f, :enabled

  br
  .block
    .block__header
      span.block__header__title Ban Options
    p.help-text.instruction If no options are selected, default ban rules will be applied. If one or more options are selected, a partial ban will be applied based on your selections.

    .field
      => checkbox f, :ban_upload_image, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_upload_image, "Upload images"

    .field
      => checkbox f, :ban_downvote_image, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_downvote_image, "Downvote images"

    .field
      => checkbox f, :ban_upvote_image, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_upvote_image, "Upvote images"

    .field
      => checkbox f, :ban_comment_images, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_comment_images, "Comment on images"

    .field
      => checkbox f, :ban_post_forum, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_post_forum, "Post in forums"

    .field
      => checkbox f, :ban_reply_forum, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_reply_forum, "Reply in forums"

    .field
      => checkbox f, :ban_send_pm, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_send_pm, "Send PMs"

    .field
      => checkbox f, :ban_api_key, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_api_key, "Use API key"

    .field
      => checkbox f, :ban_create_filters, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_create_filters, "Create filters"

    .field
      => checkbox f, :ban_galleries, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_galleries, "Manage galleries"

    .field
      => checkbox f, :ban_manage_tags, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_manage_tags, "Manage tags"

    .field
      => checkbox f, :ban_commissions, class: "granular-ban granular-ban-checkbox"
      = label f, :ban_commissions, "Commissions"

  br

  = submit "Save Ban", class: "button"
