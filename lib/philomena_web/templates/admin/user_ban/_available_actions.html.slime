.block
  .block__header
    span.block__header__title Allow Actions
  p.help-text.instruction When enabled, this banned user will retain access to this specific resource

  / Global Selection Buttons
  .global-actions
    button.button.js-select-all-global style="margin-right: 5px;" type="button" Select All
    button.button.js-deselect-all-global type="button" Deselect All
  br

  = hidden_input @f, :permitted_actions, value: ""

  = for {category, actions} <- PhilomenaWeb.BanReasonHelper.actions_grouped_by_category() do
    / Collapsible structure
    details.category-section open=false
      summary.category-header style="cursor: pointer;"
        h4.category-title style="display: inline-block; margin: 0;" = category
        
        / Category Buttons
        .category-actions.float-right style="margin-top: 3px;"
          button.button.button--small.js-select-all-category style="margin-right: 5px;" type="button" Select All Category
          button.button.button--small.js-deselect-all-category type="button" Deselect All Category
        br

      .category-body.mt-2
        = for {action_key, metadata} <- actions do
          .field
            - current_actions = Ecto.Changeset.get_field(@changeset, :permitted_actions, [])
            - is_checked = if Enum.empty?(current_actions), do: metadata.default_value, else: Enum.any?(current_actions, fn pa -> pa.action == action_key end)
            => checkbox @f, :permitted_actions, name: "#{@f.name}[permitted_actions][]", checked_value: action_key, hidden_input: false, checked: is_checked, id: "#{@f.id}_permitted_actions_#{action_key}", class: "js-permitted-action-checkbox"
            = label @f, :permitted_actions, metadata.title, for: "#{@f.id}_permitted_actions_#{action_key}"
            
            = if metadata.description != "" do
              p.action-description= metadata.description
            
            = error_tag @f, :permitted_actions